#!/bin/sh
#
# Optimise automatiquement les images stagées (JPEG : redimension 800px + qualité 80,
# via cmd/optimize-images.js) puis les re-stage, afin que la version committée soit
# la version optimisée. Les PNG/GIF et petits fichiers sont ignorés par le script.
#
# Activé par : git config core.hooksPath .githooks
# (fait automatiquement par le script "prepare" de package.json lors d'un pnpm install)
#

sources_js=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '\.(jsx?|tsx?|mjs|cjs)$')
if [ -n "$sources_js" ]; then
	printf '%s\n' "$sources_js" | xargs -d '\n' ./node_modules/.bin/oxlint --no-error-on-unmatched-pattern || {
		echo "[pre-commit] oxlint a trouvé des erreurs." >&2
		exit 1
	}
fi

# Images ajoutées/copiées/modifiées dans l'index, sous public/images
imgs=$(git diff --cached --no-renames --name-only --diff-filter=ACM -- 'public/images' | grep -Ei '\.(jpe?g|png)$')
deleted=$(git diff --cached --no-renames --name-only --diff-filter=D -- 'public/images/digimon' | grep -Ei '^public/images/digimon/[^/]+\.jpe?g$')

# Rien à optimiser
[ -z "$imgs" ] && [ -z "$deleted" ] && exit 0

if [ -n "$imgs" ]; then
	echo "[pre-commit] Optimisation des images stagées…"
	printf '%s\n' "$imgs" | xargs -d '\n' node cmd/optimize-images.js || {
		echo "[pre-commit] Échec de l'optimisation des images." >&2
		exit 1
	}

	# Re-stage les versions optimisées
	printf '%s\n' "$imgs" | xargs -d '\n' git add || exit 1
fi

sources=$(printf '%s\n%s\n' "$imgs" "$deleted" | grep -Ei '^public/images/digimon/[^/]+\.jpe?g$')
[ -z "$sources" ] && exit 0

echo "[pre-commit] Miniatures des images Digimon…"
thumbs=$(printf '%s\n' "$sources" | xargs -d '\n' node cmd/thumbnails.cmd.js) || {
	echo "[pre-commit] Échec de la génération des miniatures." >&2
	exit 1
}
[ -n "$thumbs" ] && { printf '%s\n' "$thumbs" | xargs -d '\n' git add -A -- || exit 1; }

exit 0
