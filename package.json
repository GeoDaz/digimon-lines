{
  "name": "digimon-lines",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bootstrap": "^5.2.3",
    "bootstrap-icons": "^1.11.2",
    "bootstrap-switch-button-react": "^1.2.0",
    "dom-to-image-more": "^3.7.2",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-bootstrap": "^2.7.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "jsdom": "^22.1.0",
    "oxlint": "1.94.0",
    "sharp": "^0.35.2",
    "supabase": "^2.114.0",
    "web-vitals": "^2.1.4",
    "wrangler": "^4.156.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next dev --webpack",
    "prebuild": "node cmd/sitemap.cmd.js && node cmd/thumbnails.cmd.js",
    "build": "next build --webpack",
    "daemon": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "optimize:images": "node cmd/optimize-images.js",
    "thumbnails": "node cmd/thumbnails.cmd.js",
    "mirror:relations": "node cmd/mirrorRelations.cmd.js",
    "dev:user": "node cmd/dev-user.cmd.js",
    "purge:cache": "node cmd/purge-cache.cmd.js",
    "supabase": "node cmd/supabase.cmd.js",
    "supabase:types": "node cmd/supabase.cmd.js gen types typescript --linked --schema public > src/types/supabase.ts",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
